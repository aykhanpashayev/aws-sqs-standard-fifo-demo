#!/usr/bin/env bash

set -euo pipefail

echo "Sending a message to the SQS queue..."

aws sqs send-message \
  --queue-url https://sqs.us-east-2.amazonaws.com/000345487584/Queue.fifo \
  --message-group-id "Certification" \
  --message-deduplication-id "1" \
  --message-body "AWS Solutions Architect Associate Certification coming very soon!" \
  --message-attributes file://send-message.json \
  --region us-east-2

  echo "Sending a message to the SQS queue..."

aws sqs send-message \
  --queue-url https://sqs.us-east-2.amazonaws.com/000345487584/Queue.fifo \
  --message-group-id "Certification" \
  --message-deduplication-id "2" \
  --message-body "AWS Solutions Architect Associate Certification will be mine by end of December 2025!" \
  --message-attributes file://send-message.json \
  --region us-east-2

echo "Sending a message to the SQS queue..."

aws sqs send-message \
  --queue-url https://sqs.us-east-2.amazonaws.com/000345487584/Queue.fifo \
  --message-group-id "Certification" \
  --message-deduplication-id "3" \
  --message-body "Almost half of the chapters are finished!" \
  --message-attributes file://send-message.json \
  --region us-east-2
