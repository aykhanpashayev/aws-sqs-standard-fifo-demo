#!/usr/bin/env bash

set -euo pipefail

echo "Receiving a message from the SQS queue..."
aws sqs receive-message \
  --queue-url https://sqs.us-east-2.amazonaws.com/000345487584/StandartQueue \
  --message-attribute-names All \
  --max-number-of-messages 1 \
  --region us-east-2 \
  --query 'Messages[0].{Body: Body, Attributes: MessageAttributes}' 
